# ── Clawome Browser Environment Configuration ──
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit a real key.

# ── LLM Provider (required for Task Agent) ──
# Provider id: google, openai, anthropic, deepseek, groq, ... (default: google)
LLM_PROVIDER=google

# API key for the selected provider
LLM_API_KEY=

# API base URL (only needed for OpenAI-compatible custom endpoints)
LLM_API_BASE=

# Model name (default: gemini-2.5-flash)
LLM_MODEL=gemini-2.5-flash

# ── Optional ──
# LLM temperature (0 = deterministic, default: 0)
# LLM_TEMPERATURE=0

# Max tokens per LLM response (default: 4096)
# LLM_MAX_TOKENS=4096

# Browser start URL for Task Agent (default: https://www.google.com)
# AGENT_START_URL=https://www.google.com

# Max steps per subtask (default: 15)
# AGENT_MAX_STEPS=15
